# Copy this file to .env and adjust as needed: cp .env.example .env

# Database (matches infra/docker-compose.yml)
DATABASE_URL=postgres://socialdev:socialdev@localhost:5432/socialdev

# API
API_PORT=4000
API_URL=http://localhost:4000
LOG_LEVEL=debug

# Web (public URL; the web app proxies /api/* to the API)
WEB_URL=http://localhost:3000

# Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Email (Mailpit from infra/docker-compose.yml; inbox at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Social Dev <no-reply@localhost>"

# Optional OAuth apps. Leave empty to disable the provider.
# GitHub: https://github.com/settings/developers (callback: http://localhost:3000/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitLab: https://gitlab.com/-/user_settings/applications (callback: http://localhost:3000/api/auth/callback/gitlab, scope: read_user)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
